new_tab Signal
launch zsh -c "source ~/.zshrc; gurk; exec zsh"

new_tab Top
launch zsh -c "source ~/.zshrc; btop; exec zsh"

new_tab Mozilla
layout splits
launch zsh -c "source ~/.zshrc; cd ~/workspace/firefox; gitui; exec zsh"
launch --location=hsplit --bias=40 zsh -c "source ~/.zshrc; cd ~/workspace/firefox; exec zsh"

new_tab OkShell
layout splits
launch zsh -c "source ~/.zshrc; cd ~/workspace/OkShell; gitui; exec zsh"
launch --location=hsplit --bias=40 zsh -c "source ~/.zshrc; cd ~/workspace/OkShell; exec zsh"

new_tab Dotfiles
layout splits
launch zsh -c "source ~/.zshrc; cd ~/workspace/dotfiles; gitui; exec zsh"
launch --location=hsplit --bias=40 zsh -c "source ~/.zshrc; cd ~/workspace/dotfiles; exec zsh"
